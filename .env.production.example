# Required public hostname, pointing its DNS A record to your production server.
DOMAIN=campusvoice.example.edu

# Generate long random values; never commit the completed .env.production file.
POSTGRES_DB=campus_voice
POSTGRES_USER=campus_voice
POSTGRES_PASSWORD=replace-with-a-long-random-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_TOKEN_SECRET=replace-with-a-long-random-token-secret
ADMIN_REPORT_RECIPIENT=abhilamanakkal@gmail.com

# Start with preview. Configure SMTP only when you have tested delivery.
EMAIL_MODE=preview
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=your-sending-gmail@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-sending-gmail@example.com
