# SQLite works with no configuration. Set this in production for PostgreSQL.
DATABASE_URL=postgresql+psycopg://campus_voice:change-me@localhost:5432/campus_voice
# Comma-separated frontend origins. Do not use * in production.
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# Change all three values before deployment. Local demo defaults are intentionally not production-safe.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-production
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
ADMIN_REPORT_RECIPIENT=abhilamanakkal@gmail.com

# Safe default: records approval in the audit log but does not deliver email.
EMAIL_MODE=preview
# Set EMAIL_MODE=smtp and configure the following to enable delivery.
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=campus-voice@example.edu
SMTP_PASSWORD=replace-me
SMTP_FROM=campus-voice@example.edu

# In production use a provider moderation API plus a shared Redis rate limiter.
